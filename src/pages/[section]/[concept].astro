---
import { getCollection } from "astro:content";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import ConceptLink from "@daanish02/scaffold-core/components/content/ConceptLink.astro";
import {
  getConceptStaticPaths,
  buildSidebarGroups,
  getConnectsToIds,
} from "@daanish02/scaffold-core/astro/concept-page.ts";

export async function getStaticPaths() {
  const concepts = await getCollection("concepts");
  return getConceptStaticPaths(concepts);
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, difficulty, status } = entry.data;
const connects = getConnectsToIds(entry);

const allConcepts = await getCollection("concepts");
const sidebarGroups = buildSidebarGroups(entry, allConcepts, import.meta.env.BASE_URL);
---

<ConceptLayout title={title} kb={entry.data.kb} sidebarGroups={sidebarGroups}>
  <h1 class="page-title">{title}</h1>
  <div class="meta-row">
    <span class="pill accent">{difficulty}</span>
    <span class="pill">{status}</span>
  </div>
  {
    connects.length > 0 && (
      <div class="prereqs">
        <span class="prereqs-label">Prerequisites & related</span>
        <div class="chip-row">
          {connects.map((id) => (
            <ConceptLink id={id} />
          ))}
        </div>
      </div>
    )
  }
  <div class="prose">
    <Content />
  </div>
</ConceptLayout>
