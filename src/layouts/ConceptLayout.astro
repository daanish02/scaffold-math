---
import Header from "@daanish02/scaffold-core/components/layout/Header.astro";
import Footer from "@daanish02/scaffold-core/components/layout/Footer.astro";
import Sidebar from "@daanish02/scaffold-core/components/layout/Sidebar.astro";
import "@daanish02/scaffold-core/styles/tokens.css";
import "@daanish02/scaffold-core/styles/base.css";
import "katex/dist/katex.min.css";

export interface Props {
  title: string;
  kb: string;
  sidebarGroups?: import("@daanish02/scaffold-core/components/layout/Sidebar.astro").SidebarGroup[];
}
const {
  title,
  kb,
  sidebarGroups = [{ label: kb, links: [{ href: "#", label: title, current: true }] }],
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Scaffold: {title}</title>
  </head>
  <body>
    <Header kb={kb} />
    <div class="shell">
      <Sidebar groups={sidebarGroups} />
      <main>
        <div class="content-col">
          <slot />
        </div>
      </main>
    </div>
    <Footer currentKb={kb} />
  </body>
</html>
